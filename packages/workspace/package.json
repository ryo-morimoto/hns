{
  "name": "@hns/workspace",
  "version": "0.1.0",
  "description": "Versioned file access, a journal, and exec isolation on an ExecutionEnv",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./checkpoint": {
      "source": "./src/checkpoint.ts",
      "types": "./dist/checkpoint.d.ts",
      "import": "./dist/checkpoint.js"
    },
    "./objects": {
      "source": "./src/objects.ts",
      "types": "./dist/objects.d.ts",
      "import": "./dist/objects.js"
    },
    "./mirror": {
      "source": "./src/mirror.ts",
      "types": "./dist/mirror.d.ts",
      "import": "./dist/mirror.js"
    },
    "./mirror-push": {
      "source": "./src/mirror-push.ts",
      "types": "./dist/mirror-push.d.ts",
      "import": "./dist/mirror-push.js"
    },
    "./pack": {
      "source": "./src/pack.ts",
      "types": "./dist/pack.d.ts",
      "import": "./dist/pack.js"
    },
    "./sandbox": {
      "source": "./src/sandbox.ts",
      "types": "./dist/sandbox.d.ts",
      "import": "./dist/sandbox.js"
    },
    "./protocol": {
      "source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsdown && node ../../tools/gate/dist-check.ts",
    "test": "vitest run --root ../.. --project 'workspace*'",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@hns/core": "0.1.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-env": "1.5.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
