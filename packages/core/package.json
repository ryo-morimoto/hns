{
  "name": "@hns/core",
  "version": "0.1.0",
  "description": "Domain types for hns",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graphql": {
      "source": "./src/graphql/index.ts",
      "types": "./dist/graphql/index.d.ts",
      "import": "./dist/graphql/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsdown && node ../../tools/gate/dist-check.ts",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run --root ../.. --project 'core*'"
  },
  "dependencies": {
    "graphql": "16.11.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
