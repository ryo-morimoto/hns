{
  "name": "hns",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gate": "node tools/gate/main.ts",
    "check": "node tools/gate/main.ts --all",
    "lint": "node tools/gate/main.ts lint --all",
    "lint:fix": "oxlint --fix packages",
    "fmt": "oxfmt packages",
    "fmt:check": "node tools/gate/main.ts fmt --all",
    "typecheck": "node tools/gate/main.ts typecheck --all",
    "test": "node tools/gate/main.ts test --all",
    "build": "node tools/gate/main.ts build --all",
    "docs:api": "typedoc --options typedoc.json"
  },
  "knip": {
    "workspaces": {
      "packages/*": {
        "entry": [
          "src/**/*.test.ts"
        ]
      },
      "packages/workspace": {
        "entry": [
          "src/rooted-helper.ts"
        ]
      },
      "packages/web": {
        "entry": [
          "src/**/*.test.{ts,tsx}"
        ],
        "ignoreDependencies": [
          "jsdom"
        ]
      }
    },
    "ignore": [
      "work/**",
      "tools/**"
    ],
    "ignoreDependencies": [
      "@j178/prek"
    ]
  },
  "devDependencies": {
    "@j178/prek": "0.5.10",
    "@oxlint/plugins": "1.78.0",
    "knip": "6.44.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.78.0",
    "tsdown": "0.23.7",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "vite-plugin-doctest": "3.0.0",
    "vitest": "5.1.0"
  }
}
