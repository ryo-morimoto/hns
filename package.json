{
  "name": "hns",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "npm run lint && npm run fmt:check && npm run typecheck && npm run test && npm run build && knip",
    "lint": "oxlint packages",
    "lint:fix": "oxlint --fix packages",
    "fmt": "oxfmt packages",
    "fmt:check": "oxfmt --check packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present"
  },
  "knip": {
    "workspaces": {
      "packages/*": { "entry": ["test/**/*.test.ts"] },
      "packages/workspace": { "entry": ["test/**/*.test.ts", "src/rooted-helper.ts"] }
    },
    "ignore": ["work/**", "tools/**"]
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "knip": "6.44.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.78.0",
    "vitest": "5.1.0"
  }
}
