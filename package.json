{
  "name": "hns",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gate": "node tools/gate/main.ts",
    "check": "node tools/gate/main.ts --all",
    "lint": "node tools/gate/main.ts lint --all",
    "lint:fix": "oxlint --fix packages tools/deploy",
    "fmt": "oxfmt packages tools/deploy",
    "deploy": "bash tools/deploy/deploy.sh",
    "deploy:check": "cd tools/deploy && cf deploy --dry-run --mode development",
    "postinstall": "npm install --prefix tools/deploy --no-audit --no-fund",
    "fmt:check": "node tools/gate/main.ts fmt --all",
    "record": "node packages/record/src/cli.ts",
    "codegen": "node --conditions=source tools/codegen/graphql.ts && relay-compiler",
    "typecheck": "node tools/gate/main.ts typecheck --all",
    "test": "node tools/gate/main.ts test --all",
    "build": "node tools/gate/main.ts build --all",
    "docs:api": "typedoc --options typedoc.json"
  },
  "knip": {
    "workspaces": {
      "packages/*": {
        "entry": [
          "src/**/*.test.ts"
        ]
      },
      "packages/store": {
        "entry": [
          "src/**/*.test.ts",
          "test/integration/**/*.test.ts"
        ]
      },
      "packages/machine": {
        "entry": [
          "src/**/*.test.ts",
          "test/integration/**/*.test.ts"
        ],
        "ignoreBinaries": [
          "mkfifo"
        ]
      },
      "packages/workspace": {
        "entry": [
          "src/rooted-helper.ts"
        ]
      },
      "packages/web": {
        "entry": [
          "src/**/*.test.{ts,tsx}"
        ],
        "ignoreDependencies": [
          "jsdom"
        ]
      }
    },
    "ignore": [
      "work/**",
      "tools/**",
      ".agents/**",
      "packages/web/src/__generated__/**"
    ],
    "ignoreDependencies": [
      "@j178/prek",
      "babel-plugin-relay"
    ]
  },
  "devDependencies": {
    "relay-compiler": "20.1.1",
    "@j178/prek": "0.5.10",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "24.19.2",
    "cf": "1.0.0-beta.28",
    "knip": "6.44.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.78.0",
    "tsdown": "0.23.7",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "vite-plugin-doctest": "3.0.0",
    "vitest": "5.1.0"
  }
}